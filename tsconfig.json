{
  // TypeScript for the browser code, in web/. tsgo (the Go-native TypeScript
  // compiler, pinned in tools/go.mod) only type-checks it; tools/jsbuild
  // bundles and minifies it into static/dist/ with esbuild.
  // Build:  go generate
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "rootDir": "web",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "newLine": "lf"
  },
  "include": ["web"]
}
